generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                String    @id @default(cuid())
  name              String
  gender            String
  birthDate         DateTime
  birthTime         String?
  birthTimeAccuracy String
  birthPlace        String
  timezone          String    @default("Asia/Ho_Chi_Minh")
  readings          Reading[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Reading {
  id          String   @id @default(cuid())
  slug        String   @unique
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  focusArea   String
  lifeContext String
  question    String
  synthesis   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([profileId])
}
